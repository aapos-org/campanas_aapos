<mjml>
    <mj-head>
        <mj-title>Anuncio</mj-title>
        <mj-attributes>
            <mj-all font-family="Arial, Helvetica, sans-serif" />
            <mj-text
                font-size="16px"
                line-height="24px"
                color="#1f2937"
                align="center"
            />
            <mj-button
                background-color="#b45309"
                color="#ffffff"
                font-weight="bold"
                border-radius="999px"
                font-size="18px"
                inner-padding="14px 32px"
            />
        </mj-attributes>
    </mj-head>
    <mj-body background-color="#fef3c7">
        <mj-section padding="40px 24px 0">
            <mj-column
                background-color="#ffffff"
                border-radius="12px"
                padding="32px 16px"
            >
                <mj-text
                    font-size="14px"
                    color="#b45309"
                    font-weight="bold"
                    letter-spacing="2px"
                    >ANUNCIO</mj-text
                >
                <mj-text font-size="28px" line-height="34px" font-weight="bold"
                    >Un titular claro y directo</mj-text
                >
                <mj-text
                    >{{ nombre | 'Hola' }}, explica en una o dos frases qué
                    ocurre y por qué importa.</mj-text
                >
                <mj-button href="https://example.org"
                    >Quiero participar</mj-button
                >
                <mj-text font-size="14px" color="#6b7280"
                    >Fecha límite: dd/mm/aaaa</mj-text
                >
            </mj-column>
        </mj-section>
        <mj-section padding="16px 24px 32px">
            <mj-column>
                <mj-text font-size="12px" line-height="18px" color="#78716c"
                    >{{ nombre_organizacion }} · {{ direccion_fisica }}<br /><a
                        href="{{ enlace_baja }}"
                        style="color: #78716c"
                        >Darme de baja</a
                    >
                    ·
                    <a href="{{ preferencias }}" style="color: #78716c"
                        >Preferencias</a
                    ></mj-text
                >
            </mj-column>
        </mj-section>
    </mj-body>
</mjml>
